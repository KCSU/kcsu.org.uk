---
interface Props {
  href: string;
  label: string;
  icon?: string;
  isEmail?: boolean;
  disabled?: boolean;
}

const {
  href,
  label,
  icon = "fas fa-external-link-alt",
  isEmail = false,
  disabled = false,
} = Astro.props;
---

<li>
  {
    href && !disabled ? (
      <a
        href={href}
        class="text-blue-600 hover:underline visited:text-purple-800 flex items-center"
      >
        {label}
        {icon && <i class={`${icon} ml-1.5 text-xs`} />}
      </a>
    ) : (
      <span class="flex items-center opacity-50 cursor-not-allowed">
        {label}
      </span>
    )
  }
</li>
