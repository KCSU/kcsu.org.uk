---
import Main from "../layouts/Main.astro";
---

<Main
  title="Page Not Found"
  description="This page doesn't exist. Find your way back to the KCSU website."
  noindex
>
  <div class="bg-linear-to-b from-purple-50 to-white min-h-[80vh] flex items-center justify-center">
    <div class="max-w-2xl px-4 py-20 text-center">
      <p class="text-8xl sm:text-9xl font-bold text-purple-800 leading-none">404</p>
      <h1 class="text-3xl md:text-4xl font-bold mt-4 mb-4">
        We couldn't find that page
      </h1>
      <p class="text-gray-600 mb-10">
        The page may have moved or no longer exist.
      </p>

      <ul class="flex flex-wrap justify-center gap-3 mb-12">
        <li>
          <a
            href="/"
            class="inline-block px-5 py-2 rounded-lg bg-purple-800 text-white font-medium hover:bg-purple-900 transition-colors"
          >
            Home
          </a>
        </li>
        <li>
          <a
            href="/"
            id="go-back"
            class="inline-block px-5 py-2 rounded-lg border-2 border-purple-800 text-purple-800 font-medium hover:bg-purple-50 transition-colors"
          >
            Go Back
          </a>
        </li>
      </ul>
    </div>
  </div>
</Main>

<script>
  document.getElementById("go-back")?.addEventListener("click", (event) => {
    if (window.history.length > 1) {
      event.preventDefault();
      window.history.back();
    }
  });
</script>
