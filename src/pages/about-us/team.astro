---
import Main from '../../layouts/Main.astro';
import execData from '../../data/exec.json';

interface TeamMember {
  name: string;
  role: string;
  email: string;
  image: string;
  description: string;
}

const teamMembers: TeamMember[] = execData;

---

<Main title="KCSU Executive Team">
  <div class="bg-gradient-to-b from-purple-50 to-white min-h-screen">
    <div class="container mx-auto px-4 py-16">

      <!-- Header Section -->
      <div class="text-center max-w-3xl mb-10 mx-auto pt-8">
        <h1 class="text-6xl font-bold text-gray-900 mb-8 leading-tight">
          Meet the Team
        </h1>
        <div class="h-1.5 w-32 bg-purple-600 mx-auto mb-10"></div>
        <p class="text-xl text-gray-600 italic">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        </p>
      </div>

      <!-- View Toggle Buttons -->
      <div class="flex justify-end mb-6">
        <div class="inline-flex items-center bg-gray-100 rounded-lg p-1 shadow-sm">
          <button id="cardViewButton" class="flex items-center px-4 py-2 rounded-md bg-white text-purple-800 shadow-sm font-medium transition-all duration-0">
            <i class="fas fa-th text-lg mr-2"></i>
            <span>Cards</span>
          </button>
          <button id="tableViewButton" class="flex items-center px-4 py-2 rounded-md text-gray-600 hover:text-gray-800 font-medium transition-all duration-0">
            <i class="fas fa-list-ul text-lg mr-2"></i>
            <span>Table</span>
          </button>
        </div>
      </div>

      <!-- Card View -->
      <div id="cardView" class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {teamMembers.map((member: TeamMember) => (
          <div class="bg-white text-gray-900 rounded-xl shadow-md p-8 flex items-start justify-between">
            <div class="grow">
              <h3 class="text-3xl font-bold">{member.role}</h3>
              <p class="text-gray-600 italic mb-2">{member.email}</p>
              <p>{member.description}</p>
            </div>
            <div class="flex-none text-center ml-8 w-36">
              <img src={member.image} alt={member.name} class="w-36 h-36 rounded-full mx-auto" />
              <p class="mt-4 font-bold">{member.name}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Table View -->
      <div id="tableView" class="hidden">
        <table class="min-w-full bg-white border border-gray-200">
          <thead>
            <tr class="bg-gray-300 text-gray-900 uppercase leading-normal">
              <th class="py-3 px-6 text-left">Name</th>
              <th class="py-3 px-6 text-left">Role</th>
              <th class="py-3 px-6 text-left">Email</th>
            </tr>
          </thead>
          <tbody class="text-gray-800 font-light">
            {teamMembers.map((member: TeamMember) => (
              <tr class="border-b border-gray-200 hover:bg-gray-200 odd:bg-gray-100">
                <td class="py-3 px-6">{member.name}</td>
                <td class="py-3 px-6">{member.role}</td>
                <td class="py-3 px-6">
                  <a href={`mailto:${member.email}`} class="text-purple-700 hover:text-purple-900">
                    {member.email}
                  </a>
                  </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Footer Note -->
      <div class="mt-16 pt-8 border-t border-gray-200">
        <div class="flex items-center justify-between text-sm text-gray-500">
          <p>
            This document is subject to change. For any queries, please contact
            <a href="mailto:president@kcsu.org.uk" class="text-purple-800 hover:text-purple-900">the KCSU President</a>.
          </p>
          <a 
            href="#" 
            class="inline-flex items-center text-purple-600 hover:text-purple-800"
          >
            Back to top
            <i class="fa-solid fa-arrow-up ml-1"></i>
          </a>
        </div>
        <div class="text-sm text-gray-500 mt-2">
          Last updated: 15/03/2025
        </div>
      </div>
    </div>
  </div>
</Main>

<script>
  $(document).ready(function() {
    const $cardViewButton = $('#cardViewButton');
    const $tableViewButton = $('#tableViewButton');
    const $cardView = $('#cardView');
    const $tableView = $('#tableView');
    
    // Classes to be toggled
    const classes = "bg-white text-purple-800 shadow-sm text-gray-600 hover:text-gray-800";

    const toggleView = () => {
      // Toggle views
      $cardView.toggleClass('hidden');
      $tableView.toggleClass('hidden');

      // Toggle button styles
      $cardViewButton.toggleClass(classes);
      $tableViewButton.toggleClass(classes);

      // Update URL
      const url = new URL(window.location.href);
      if ($tableView.hasClass('hidden')) {
        url.searchParams.set('view', 'card');
      } else {
        url.searchParams.set('view', 'table');
      }
      window.history.pushState(null, '', url.toString());
    };

    $tableViewButton.on('click', toggleView);
    $cardViewButton.on('click', toggleView);

    // Check if query string specifies table view
    const urlSearchParams = new URLSearchParams(window.location.search);
    const params = Object.fromEntries(urlSearchParams.entries());
    const isTableView = params.view === "table";
    if (isTableView) {
      toggleView();
    }
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
  .table {
    display: table;
    width: 100%;
  }
  .table > div {
    display: table-row;
  }
  .table > div > div {
    display: table-cell;
    padding: 16px;
    border-bottom: 1px solid #e5e7eb;
  }

  #cardViewButton i, #tableViewButton i {
    -webkit-text-stroke: 10px background-color;
  }
</style> 