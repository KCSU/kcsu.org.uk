---
import { Image } from "astro:assets";

interface CarouselImage {
  src: any;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  logo?: any;
  title?: string;
  subtitle?: string;
  blurb?: string;
}

const { images, logo, title, subtitle, blurb } = Astro.props;
---

<section
  id="carousel-section"
  class="relative grid grid-cols-1 grid-rows-1 overflow-hidden group"
>
  <!-- Carousel content -->
  <div
    class="inset-0 bg-black/30 flex items-center justify-center z-20 pointer-events-none min-h-[50vh] p-7 grid-overlap"
  >
    <div
      class="flex flex-col sm:flex-row items-center gap-4 sm:gap-8 pointer-events-auto min-w-[70%] bg-black/40 rounded-md p-6 justify-center"
    >
      {
        logo && (
          <Image
            src={logo}
            alt="Logo"
            class="w-28 h-28 sm:w-22 md:w-36 sm:h-22 md:h-36 object-contain pointer-events-none mb-4 sm:mb-0"
          />
        )
      }
      <div class="text-white text-center sm:text-left">
        {
          title && (
            <h1 class="text-3xl md:text-5xl font-bold mb-2 md:mb-4 pointer-events-none">
              {title}
            </h1>
          )
        }
        {
          subtitle && (
            <p class="text-lg md:text-xl mb-4 pointer-events-none">
              {subtitle}
            </p>
          )
        }
        <div class="rounded-md max-w-[40rem]">
          {blurb}
          <p class="text-gray-900"></p>
        </div>
      </div>
    </div>
  </div>

  <!-- adjust height of carousel here -->
  <div class="w-full h-full pointer-events-none absolute grid-overlap -z-10">
    <div
      class="flex transition-transform duration-500 ease-in-out h-full"
      id="carousel-image-container"
    >
      {
        images.map((image) => (
          <div class="w-full flex-shrink-0 ">
            <Image
              src={image.src}
              alt={image.alt}
              class="w-full h-full object-cover"
              width={1600}
              height={900}
            />
          </div>
        ))
      }
    </div>
  </div>
  <!-- Navigation arrows -->
  <button
    class="absolute left-2 sm:leftt-4 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/75 text-white w-10 h-10 sm:w-12 md:w-14 sm:h-12 md:h-14 flex items-center justify-center rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-30 grid-overlap"
    id="prev-button"
    aria-label="Previous image"
  >
    <i class="fas fa-chevron-left text-xl sm:text-2xl"></i>
  </button>

  <button
    class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/75 text-white w-10 h-10 sm:w-12 md:w-14 sm:h-12 md:h-14 flex items-center justify-center rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-30 grid-overlap"
    id="next-button"
    aria-label="Next image"
  >
    <i class="fas fa-chevron-right text-xl sm:text-2xl"></i>
  </button>
</section>

<script define:vars={{ imageCount: images.length }}>
  $(document).ready(() => {
    let currentIndex = 0;
    const $container = $("#carousel-image-container");
    const $prevButton = $("#prev-button");
    const $nextButton = $("#next-button");
    const $carouselSection = $("#carousel-section"); // Get the entire carousel section

    const updateCarousel = () =>
      $container.css("transform", `translateX(-${currentIndex * 100}%)`);

    const nextImage = () => {
      currentIndex = (currentIndex + 1) % imageCount;
      updateCarousel();
    };

    const prevImage = () => {
      currentIndex = (currentIndex - 1 + imageCount) % imageCount;
      updateCarousel();
    };

    // bind function to buttons
    $prevButton.on("click", prevImage);
    $nextButton.on("click", nextImage);

    // todo: do we want auto scroll?
    let autoScrollInterval = setInterval(nextImage, 5000);

    // pause auto-scroll when hovering over the entire carousel section, including buttons
    $carouselSection
      .on("mouseover", () => {
        clearInterval(autoScrollInterval);
        autoScrollInterval = null;
      })
      .on("mouseleave", () => {
        if (!autoScrollInterval) {
          autoScrollInterval = setInterval(nextImage, 5000);
        }
      });
  });
</script>
<style>
  .grid-overlap {
    grid-column: 1/1;
    grid-row: 1/1;
  }
</style>
