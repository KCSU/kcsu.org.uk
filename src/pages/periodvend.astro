<body>
<header>
    <nav><a href="https://kcsu.org.uk/">Home</a></nav></header>

<main>
    <h1>Period Vend Restock Request</h1>
    <hr>
    <form action="" method="get">
    <select name="location" id="location-select">
      <option value="keynes-cub">Keynes Cubicles</option>
      <option value="keynes-uri">Keynes + Urinals</option>
      <option value="garden-hostel">Garden Hostels</option>
      <option value="library">Library</option>
      <option value="other">Other</option>
    </select>
    <button class="btn outline" type="submit" value="Send">Send Request</button>
</form>
<p class="reminder">or email <a href="mailto:genderequality@kcsu.org.uk">genderequality<wbr>@kcsu.org.uk</a>!</p>
</main>


</body>
</html>

<style>

:root{
    --k-purple: #59276c;
    --k-highlight: #CFBE54;
}

body{
