---
import Main from '../../layouts/Main.astro';
import DocumentHeader from '../../components/DocumentHeader.astro';
import DocumentFooter from '../../components/DocumentFooter.astro';
import PageNavigation from '../../components/PageNavigation.astro';
import societiesData from '../../data/societies.json';

export async function getStaticPaths() {
  return [
    { params: { type: 'academic' }, props: { title: 'Academic Societies' } },
    { params: { type: 'sports' }, props: { title: 'Sports Societies' } },
    { params: { type: 'others' }, props: { title: 'Other Societies' } },
  ];
}

const { type } = Astro.params;
const { title } = Astro.props;

interface Contact {
  name: string;
  email: string;
}

interface Society {
  id: string;
  type: string;
  name: string;
  description?: string;
  contacts: Contact[];
  image: string;
  links?: {
    website?: string;
    instagram?: string;
    wikipedia?: string;
    calendar?: string;
  };
}

const societies: Society[] = societiesData.filter(society => society.type === type);

// Map societies to nav items for the sidebar
const navItems = societies.map(society => ({
  id: society.id,
  title: society.name
}));
---

<Main title={title}>
  <div class="bg-linear-to-b from-purple-50 to-slate-50 min-h-screen">
    <div class="container mx-auto px-4 py-16">
      <DocumentHeader title={title} />

      <div class="flex flex-col lg:flex-row gap-8 mt-12 relative">
        <!-- Navigation sidebar -->
        <PageNavigation items={navItems} />

        <!-- Societies list -->
        <div class="lg:w-3/4 space-y-10">
          {societies.map((society) => (
            <div id={society.id} class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl scroll-mt-28">
              <div class="flex flex-col md:flex-row">
                <!-- Society Details -->
                <div class="p-8 md:w-3/5 min-h-48">
                  <h2 class="text-3xl font-bold text-gray-900 mb-4">{society.name}</h2>
                  
                  <div class="text-gray-700 whitespace-pre-wrap mb-6">{society.description || "(check back later!)"}</div>

                  {society.links && (
                    <div class="flex gap-4 mb-6">
                      {society.links.website && (
                        <a href={society.links.website} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-purple-600 transition-colors" title="Website">
                          <i class="fas fa-globe fa-lg"></i>
                        </a>
                      )}
                      {society.links.instagram && (
                        <a href={`https://instagram.com/${society.links.instagram}`} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-pink-600 transition-colors" title="Instagram">
                          <i class="fab fa-instagram fa-lg"></i>
                        </a>
                      )}
                      {society.links.wikipedia && (
                        <a href={society.links.wikipedia} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900 transition-colors" title="Wikipedia">
                          <i class="fab fa-wikipedia-w fa-lg"></i>
                        </a>
                      )}
                      {society.links.calendar && (
                        <a href={society.links.calendar} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-red-600 transition-colors" title="Calendar">
                          <i class="fas fa-calendar fa-lg"></i>
                        </a>
                      )}
                    </div>
                  )}
                  
                  <div class="mt-6">
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">Contact Information</h3>
                    { society.contacts.length > 0 ? (
                      <ul class="space-y-2">
                        {society.contacts.map((contact) => (
                            <li>
                            <span class="font-medium">{contact.name}</span> - <a href={`mailto:${contact.email}`} class="inline text-purple-700 hover:text-purple-900">
                                {contact.email}
                            </a>
                            </li>
                        ))}
                      </ul>
                    ) : "(tbc)"}
                  </div>
                </div>
                
                <!-- Society Image -->
                <div class="md:w-2/5">
                  <img 
                    src={society.image} 
                    alt={`${society.name} Photo`}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-center min-h-[300px]"
                  />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Create a new society section -->
      <div class="mt-24 bg-white p-8 rounded-md shadow-md border-l-[6px] border-purple-500">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Start Your Own Society</h2>
        <p class="text-gray-700 mb-6">
          Interested in starting a new society at King's? The KCSU is always happy to welcome new initiatives.
          Contact the KCSU Sports & Societies Officer for guidance on how to establish and fund your society.
        </p>
        <a href="mailto:sports.societies@kcsu.org.uk" class="inline-flex items-center px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">
          Contact Us
          <i class="fas fa-arrow-right ml-2"></i>
        </a>
      </div>

      <!-- UPDATE ME!!! -->
      <DocumentFooter lastUpdated="06/02/2026" />
    </div>
  </div>
</Main>
