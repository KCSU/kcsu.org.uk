---
import Main from '../../layouts/Main.astro';
import DocumentHeader from '../../components/DocumentHeader.astro';
import DocumentFooter from '../../components/DocumentFooter.astro';
import execData from '../../data/exec.json';

interface TeamMember {
  names: string[];
  role: string;
  emails: string[];
  image: string;
  description: string;
}

const teamMembers: TeamMember[] = execData;

---

<Main title="The Exec">
  <div class="bg-gradient-to-b from-purple-50 to-white min-h-screen">
    <div class="container mx-auto px-4 py-16">

      <!-- Header section -->
      <DocumentHeader
        title="Meet the Team"
        subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
      />

      <!-- Toggle buttons -->
      <div class="flex justify-end mb-6">
        <div class="inline-flex items-center bg-gray-100 rounded-lg p-1 shadow-sm">
          <button id="cardViewButton" class="flex items-center px-4 py-2 rounded-md bg-white text-purple-800 shadow-sm font-medium transition-all duration-0">
            <i class="fas fa-th text-lg mr-2"></i>
            <span>Cards</span>
          </button>
          <button id="tableViewButton" class="flex items-center px-4 py-2 rounded-md text-gray-600 hover:text-gray-800 font-medium transition-all duration-0">
            <i class="fas fa-list-ul text-lg mr-2"></i>
            <span>Table</span>
          </button>
        </div>
      </div>

      <!-- Card view -->
      <div id="cardView" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-6 md:gap-8">
        {teamMembers.map((member: TeamMember) => (
          <div class="bg-white text-gray-900 rounded-xl shadow-md overflow-hidden transition-all duration-300 hover:shadow-xl">
            <!-- Mobile layout -->
            <div class="flex flex-col md:hidden p-6">
              <div class="flex mb-4">
                <div class="flex-1 pr-4 my-auto">
                  <h3 class="text-2xl/6 font-bold mb-1">{member.role}</h3>
                  <p class="text-lg/5 font-bold mb-1">{member.names.join(", ")}</p>
                  <div>
                    {member.emails.map((email, i) => (
                      <a href={`mailto:${email}`} class="text-gray-600 italic text-sm block">
                        {email}{i < member.emails.length - 1 ? "," : ""}
                      </a>
                    ))}
                  </div>
                </div>
                <div class="flex-none">
                  <img src={member.image} alt={member.names.join(", ")} class="w-28 h-28 rounded-full object-cover" />
                </div>
              </div>
              <div>
                <p class="text-sm">{member.description}</p>
              </div>
            </div>
            
            <!-- Tablet/Desktop layout -->
            <div class="hidden md:flex p-6 items-start">
              <div class="grow min-w-0 pr-8 my-1">
                <h3 class="text-2xl/7 font-bold">{member.role}</h3>
                <div class="text-gray-600 italic mb-3 text-sm">
                  {member.emails.map((email, i) => (
                    <a href={`mailto:${email}`} class="inline-block">
                      {email}{i < member.emails.length - 1 ? ", " : ""}
                    </a>
                  ))}
                </div>
                <p class="text-sm">{member.description}</p>
              </div>
              <div class="flex-none text-center w-24 md:w-28 lg:w-32 mt-1">
                <img src={member.image} alt={member.names[0]} class="w-24 h-24 md:w-28 md:h-28 lg:w-32 lg:h-32 rounded-full object-cover" />
                <p class="mt-3 font-bold text-base/5">{member.names.join(", ")}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Table view -->
      <div id="tableView" class="hidden overflow-hidden rounded-lg overflow-x-auto">
        <table class="min-w-full bg-white border border-gray-200">
          <thead>
            <tr class="bg-gray-300 text-gray-900 uppercase leading-normal">
              <th class="py-3 px-6 text-left">Name</th>
              <th class="py-3 px-6 text-left">Role</th>
              <th class="py-3 px-6 text-left">Email</th>
            </tr>
          </thead>
          <tbody class="text-gray-800 font-light">
            {teamMembers.map((member: TeamMember) => (
              <tr class="border-b border-gray-200 hover:bg-gray-200 odd:bg-gray-100">
                <td class="py-3 px-6">{member.names.join(", ")}</td>
                <td class="py-3 px-6">{member.role}</td>
                <td class="py-3 px-6">
                  {member.emails.map((email, i) => (
                    <>
                      <a href={`mailto:${email}`} class="text-purple-700 hover:text-purple-900">{email}</a>{i < member.emails.length - 1 ? ", " : ""}
                    </>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- UPDATE ME!!! -->
      <DocumentFooter lastUpdated="19/03/2025"/>
    </div>
  </div>
</Main>

<script>
  $(document).ready(function() {
    const $cardViewButton = $('#cardViewButton');
    const $tableViewButton = $('#tableViewButton');
    const $cardView = $('#cardView');
    const $tableView = $('#tableView');
    
    // Classes to be toggled
    const classes = "bg-white text-purple-800 shadow-sm text-gray-600 hover:text-gray-800";

    const toggleView = () => {
      // Toggle views
      $cardView.toggleClass('hidden');
      $tableView.toggleClass('hidden');

      // Toggle button styles
      $cardViewButton.toggleClass(classes);
      $tableViewButton.toggleClass(classes);

      // Update URL
      const url = new URL(window.location.href);
      if ($tableView.hasClass('hidden')) {
        url.searchParams.set('view', 'card');
      } else {
        url.searchParams.set('view', 'table');
      }
      window.history.pushState(null, '', url.toString());
    };

    $tableViewButton.on('click', toggleView);
    $cardViewButton.on('click', toggleView);

    // Check if query string specifies table view
    const urlSearchParams = new URLSearchParams(window.location.search);
    const params = Object.fromEntries(urlSearchParams.entries());
    const isTableView = params.view === "table";
    if (isTableView) {
      toggleView();
    }
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
  .table {
    display: table;
    width: 100%;
  }
  .table > div {
    display: table-row;
  }
  .table > div > div {
    display: table-cell;
    padding: 16px;
    border-bottom: 1px solid #e5e7eb;
  }
</style> 