---
import Main from '../layouts/Main.astro';
import DocumentHeader from '../components/DocumentHeader.astro';
import Badge from '../components/Badge.astro';
---

<Main title="Servery Menu">
  <div class="bg-gradient-to-b from-purple-50 to-white min-h-screen">
    <div class="container mx-auto px-4 py-16">

      <!-- Header Section -->
      <DocumentHeader
        title="Servery Menu"
        subtitle="Lorem ipsum dolor sit amet, consectetur adipisicing elit."
      />

      <!-- Today's Menu Section -->
      <div class="bg-white rounded-xl shadow-sm p-8 lg:p-12 mt-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">13 Mar 2025 (Thursday)</h2>

        <!-- Grid for Lunch and Dinner -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Lunch Section -->
          <div>
            <h3 class="text-3xl font-bold text-purple-700 mb-4">Lunch</h3>
            <ul class="space-y-4">
              <li>
                <strong class="text-xl text-gray-800">Mains</strong>
                <div class="pt-2">
                  <ul class="list-disc space-y-1">
                    <li class="flex justify-between pb-2">
                      <span class="w-4/5 pr-5">
                        Roast cauliflower steak, crushed white beans & aromatic lemongrass & coriander marinade
                        <Badge label="Ve" color="green" />
                      </span>
                      <span class="w-1/5 text-gray-600 text-right">£2.85 / £4.15</span>
                    </li>
                    <li class="flex justify-between pb-2">
                      <span class="w-4/5 pr-5">Bengali Spiced salmon (F)(M) lime leaf & coconut sauce</span>
                      <span class="w-1/5 text-gray-600 text-right">£3.80 / £4.85</span>
                    </li>
                    <li class="flex justify-between pb-2">
                      <span class="w-4/5 pr-5">Chargrilled smokey BBQ pork rib steak</span>
                      <span class="w-1/5 text-gray-600 text-right">£3.60 / £4.50</span>
                    </li>
                  </ul>
                </div>
              </li>
              <li>
                <strong class="text-lg text-gray-800">Soup</strong>
                <div class="pt-2">
                  <ul class="list-disc space-y-1">
                    <li class="flex justify-between">
                      <span>Soup of the day & roll or gluten free roll</span>
                      <span class="text-gray-600">£1.30 / £1.80</span>
                    </li>
                  </ul>
                </div>
              </li>
              <li>
                <strong class="text-lg text-gray-800">Sides</strong>
                <div class="pt-2">
                  <ul class="list-disc space-y-1">
                    <li class="flex justify-between pb-1">
                      <span>Curry fries</span>
                      <span class="text-gray-600">£1.20 / £1.65</span>
                    </li>
                    <li class="flex justify-between pb-1">
                      <span>Fries</span>
                      <span class="text-gray-600">£1.20 / £1.65</span>
                    </li>
                    <li class="flex justify-between pb-1">
                      <span>Aromatic spiced rice</span>
                      <span class="text-gray-600">£1.20 / £1.65</span>
                    </li>
                    <li class="flex justify-between pb-1">
                      <span>Mangetout, sugar snaps & peas</span>
                      <span class="text-gray-600">£1.20 / £1.65</span>
                    </li>
                    <li class="flex justify-between pb-1">
                      <span>Courgettes</span>
                      <span class="text-gray-600">£1.20 / £1.65</span>
                    </li>
                  </ul>
                </div>
              </li>
              <li>
                <strong class="text-lg text-gray-800">Hot Dessert</strong>
                <div class="pt-2">
                  <ul class="list-disc space-y-1">
                    <li class="flex justify-between">
                      <span>Dessert of the day</span>
                      <span class="text-gray-600">£1.70 / £2.10</span>
                    </li>
                  </ul>
                </div>
              </li>
            </ul>
          </div>

          <!-- Dinner Section -->
          <div class="md:border-l md:pl-8">
            <h3 class="text-3xl font-bold text-purple-700 mb-4">Dinner</h3>
            <ul class="space-y-4">
              <li>
                <strong class="text-lg text-gray-800">Mains</strong>
                <div class="pt-2">
                  <ul class="list-disc space-y-1">
                    <li class="flex justify-between pb-2">
                      <span class="w-4/5 pr-5">Sample dinner item 1</span>
                      <span class="w-1/5 text-gray-600 text-right">£3.50 / £4.50</span>
                    </li>
                    <li class="flex justify-between pb-2">
                      <span class="w-4/5 pr-5">Sample dinner item 2</span>
                      <span class="w-1/5 text-gray-600 text-right">£3.80 / £4.85</span>
                    </li>
                  </ul>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Footer Note -->
      <div class="mt-16 pt-8 border-t border-gray-200">
        <div class="flex items-center justify-between text-sm text-gray-500">
          <p>
            Menu is subject to change. Last updated: 12 March 2025.
          </p>
          <a 
            href="#" 
            class="inline-flex items-center text-purple-600 hover:text-purple-800"
          >
            Back to top
            <i class="fa-solid fa-arrow-up ml-1"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</Main>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>