---
interface NavItem {
  id: string;
  title: string;
  [key: string]: any; // Allow for other properties
}

interface Props {
  items: NavItem[];
  title?: string;
  showId?: boolean; // Option to show or hide the ID prefix
}

const { items, title = "On This Page", showId = false } = Astro.props;
---

<div class="hidden lg:block lg:w-1/4 h-fit mt-2 sticky top-28">
  <div class="relative">
    <!-- Scroll up indicator -->
    <div class="absolute top-0 left-0 right-0 flex justify-center z-20 opacity-0 pointer-events-none transition-opacity duration-200 scroll-up-indicator">
      <button class="bg-white rounded-full text-sm mt-3 w-12 h-8 shadow-lg/15 text-purple-700 hover:text-purple-900 transition-colors relative z-10">
        <i class="fas fa-chevron-up pt-[5px]"></i>
      </button>
    </div>
    
    <!-- Navigation content -->
    <div class="pl-6 overflow-y-auto max-h-[70vh] pr-4 overscroll-contain relative nav-container">
      <h3 class="text-lg font-bold text-gray-800 mb-3 ml-1.5">{title}</h3>
      <ul class="space-y-2">
        {items.map((item) => (
          <li 
            class="relative -ml-0.5 pl-0.5 text-gray-600 border-l-2 border-transparent transition-all duration-100 nav-item" 
            data-target-id={item.id}
          >
            <a 
              href={`#${item.id}`} 
              class="block py-1 pl-2 hover:text-purple-700 transition-colors duration-100 nav-link group"
              data-nav-id={item.id}
            >
              {showId && item.id && (
                <span class="mr-2 group-hover:text-purple-700 transition-colors duration-100">
                  {item.id}.
                </span>
              )}
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
    
    <!-- Scroll down indicator -->
    <div class="absolute bottom-0 left-0 right-0 flex justify-center z-20 opacity-0 pointer-events-none transition-opacity duration-200 scroll-down-indicator">
      <button class="bg-white/95 rounded-full text-sm mb-3 w-12 h-8 shadow-lg/15 text-purple-700 hover:text-purple-900 transition-colors relative z-10">
        <i class="fas fa-chevron-down pt-[5px]"></i>
      </button>
    </div>
  </div>
</div>

<script>
  $(document).ready(() => {
    // DOM elements
    const $sections = $('[id]');
    const $navItems = $('.nav-item');
    const $navContainer = $('.nav-container');
    const $scrollUpIndicator = $('.scroll-up-indicator');
    const $scrollDownIndicator = $('.scroll-down-indicator');
    let isScrollingProgrammatically = false;
    
    // Update scroll indicators visibility
    const updateScrollIndicators = () => {
      const container = $navContainer[0];
      if (!container) return;
      
      const scrollTop = container.scrollTop;
      const scrollBottom = container.scrollHeight - container.scrollTop - container.clientHeight;
      
      $scrollUpIndicator.css('opacity', scrollTop > 20 ? 1 : 0)
        .css('pointer-events', scrollTop > 20 ? 'auto' : 'none');
      
      $scrollDownIndicator.css('opacity', scrollBottom > 20 ? 1 : 0)
        .css('pointer-events', scrollBottom > 20 ? 'auto' : 'none');
    };
    
    // Scroll handlers
    $scrollUpIndicator.on('click', 'button', () => 
      $navContainer.animate({ scrollTop: 0 }, 200, updateScrollIndicators));
    
    $scrollDownIndicator.on('click', 'button', () => {
      const container = $navContainer[0];
      if (!container) return;
      $navContainer.animate({ 
        scrollTop: container.scrollHeight - container.clientHeight 
      }, 200, updateScrollIndicators);
    });
    
    // Center active item
    const scrollItemToCenter = ($item: JQuery<HTMLElement>) => {
      if (!$item.length || !$navContainer.length) return;
      
      const containerHeight = $navContainer.height() || 0;
      const itemHeight = $item.outerHeight() || 0;
      const itemTop = $item.position()?.top || 0;
      const scrollTo = itemTop - (containerHeight / 2) + (itemHeight / 2) + ($navContainer.scrollTop() || 0);
      
      $navContainer.stop().animate({ scrollTop: scrollTo }, 200, updateScrollIndicators);
    };
    
    // Highlight active navigation item
    const highlightActiveLink = (id: string) => {
      $navItems
        .removeClass('border-purple-600 font-medium text-purple-800')
        .addClass('border-transparent text-gray-600');
      
      const $activeItem = $(`[data-target-id="${id}"]`);
      if ($activeItem.length) {
        $activeItem
          .removeClass('border-transparent text-gray-600')
          .addClass('border-purple-600 font-medium text-purple-800');
        
        // Prevent another scroll to center when already scrolling
        if (!isScrollingProgrammatically) {
          scrollItemToCenter($activeItem);
        }
      }
    };
    
    // Set up Intersection Observer
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && entry.target.id) {
            highlightActiveLink(entry.target.id);
          }
        });
      },
      { rootMargin: `-50% 0px -50% 0px`, threshold: 0 }
    );
    
    // Observe sections
    $sections.each(function() { observer.observe(this); });
    
    // Handle navigation clicks
    $('.nav-link').on('click', function(e) {
      e.preventDefault();
      
      isScrollingProgrammatically = true;
      setTimeout(() => { isScrollingProgrammatically = false; }, 600);
      
      const id = $(this).data('nav-id');
      if (id) {
        const $targetSection = $(`#${id}`);
        if ($targetSection.length) {
          const headerHeight = 85;
          const targetOffset = $targetSection.offset()?.top || 0;
          
          $('html, body').animate({ scrollTop: targetOffset - headerHeight }, 75);
        }
      }
    });
    
    $navContainer.on('scroll', updateScrollIndicators);
    updateScrollIndicators();
    
    // Initial highlight
    const firstItemId = $navItems.first().data('target-id');
    if (firstItemId) {
      highlightActiveLink(firstItemId);
    }
  });
</script>

<style>
  /* Hide scrollbar */
  .nav-container {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  
  .nav-container::-webkit-scrollbar {
    display: none;
  }
</style> 