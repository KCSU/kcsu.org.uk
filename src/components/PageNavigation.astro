---
interface NavItem {
  id: string;
  title: string;
  [key: string]: any; // Allow for other properties
}

interface Props {
  items: NavItem[];
  title?: string;
  showId?: boolean; // Option to show or hide the ID prefix
}

const { items, title = "On This Page", showId = false } = Astro.props;
---

<div class="hidden lg:block lg:w-1/4 h-fit mt-2 sticky top-28">
  <div class="relative">
    <!-- Scroll up indicator -->
    <div class="absolute top-0 left-0 right-0 flex justify-center z-20 opacity-0 pointer-events-none transition-opacity duration-200 scroll-up-indicator">
      <button class="bg-white rounded-full text-sm mt-3 w-12 h-8 shadow-lg/15 text-purple-700 hover:text-purple-900 transition-colors relative z-10">
        <i class="fas fa-chevron-up pt-[5px]"></i>
      </button>
    </div>
    
    <!-- Navigation content -->
    <div class="pl-6 overflow-y-auto max-h-[70vh] pr-4 overscroll-contain relative nav-container">
      <h3 class="text-lg font-bold text-gray-800 mb-3 ml-1.5">{title}</h3>
      <ul class="space-y-2">
        {items.map((item) => (
          <li 
            class="relative -ml-0.5 pl-0.5 text-gray-600 border-l-2 border-transparent transition-all duration-100 nav-item" 
            data-target-id={item.id}
          >
            <a 
              href={`#${item.id}`} 
              class="block py-1 pl-2 hover:text-purple-700 transition-colors duration-100 nav-link group"
              data-nav-id={item.id}
            >
              {showId && item.id && (
                <span class="mr-2 group-hover:text-purple-700 transition-colors duration-100">
                  {item.id}.
                </span>
              )}
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
    
    <!-- Scroll down indicator -->
    <div class="absolute bottom-0 left-0 right-0 flex justify-center z-20 opacity-0 pointer-events-none transition-opacity duration-200 scroll-down-indicator">
      <button class="bg-white/95 rounded-full text-sm mb-3 w-12 h-8 shadow-lg/15 text-purple-700 hover:text-purple-900 transition-colors relative z-10">
        <i class="fas fa-chevron-down pt-[5px]"></i>
      </button>
    </div>
  </div>
</div>

<script>
  const sections = document.querySelectorAll<HTMLElement>("[id]");
  const navItems = document.querySelectorAll<HTMLElement>(".nav-item");
  const navContainer = document.querySelector<HTMLElement>(".nav-container");
  const scrollUp = document.querySelector<HTMLElement>(".scroll-up-indicator");
  const scrollDown = document.querySelector<HTMLElement>(".scroll-down-indicator");
  let isScrollingProgrammatically = false;

  const ACTIVE = ["border-purple-600", "font-medium", "text-purple-800"];
  const INACTIVE = ["border-transparent", "text-gray-600"];

  const setIndicator = (el: HTMLElement | null, visible: boolean) => {
    if (!el) return;
    el.style.opacity = visible ? "1" : "0";
    el.style.pointerEvents = visible ? "auto" : "none";
  };

  const updateScrollIndicators = () => {
    if (!navContainer) return;
    const top = navContainer.scrollTop;
    const bottom = navContainer.scrollHeight - top - navContainer.clientHeight;
    setIndicator(scrollUp, top > 20);
    setIndicator(scrollDown, bottom > 20);
  };

  scrollUp?.querySelector("button")?.addEventListener("click", () => {
    navContainer?.scrollTo({ top: 0, behavior: "smooth" });
  });

  scrollDown?.querySelector("button")?.addEventListener("click", () => {
    if (!navContainer) return;
    navContainer.scrollTo({
      top: navContainer.scrollHeight - navContainer.clientHeight,
      behavior: "smooth",
    });
  });

  // Centre the active item within the scrollable nav
  const scrollItemToCenter = (item: HTMLElement) => {
    if (!navContainer) return;
    const itemRect = item.getBoundingClientRect();
    const containerRect = navContainer.getBoundingClientRect();
    const offset = itemRect.top - containerRect.top;
    const scrollTo =
      navContainer.scrollTop + offset - navContainer.clientHeight / 2 + itemRect.height / 2;
    navContainer.scrollTo({ top: scrollTo, behavior: "smooth" });
  };

  const highlightActiveLink = (id: string) => {
    navItems.forEach((item) => {
      item.classList.remove(...ACTIVE);
      item.classList.add(...INACTIVE);
    });

    const activeItem = document.querySelector<HTMLElement>(`[data-target-id="${id}"]`);
    if (!activeItem) return;

    activeItem.classList.remove(...INACTIVE);
    activeItem.classList.add(...ACTIVE);

    // Avoid fighting a scroll the user just triggered
    if (!isScrollingProgrammatically) scrollItemToCenter(activeItem);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.target.id) highlightActiveLink(entry.target.id);
      });
    },
    { rootMargin: "-50% 0px -50% 0px", threshold: 0 },
  );
  sections.forEach((section) => observer.observe(section));

  document.querySelectorAll<HTMLElement>(".nav-link").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      isScrollingProgrammatically = true;
      setTimeout(() => {
        isScrollingProgrammatically = false;
      }, 600);

      const id = link.dataset.navId;
      const target = id ? document.getElementById(id) : null;
      if (!target) return;

      const headerHeight = 85;
      const top = target.getBoundingClientRect().top + window.scrollY - headerHeight;
      window.scrollTo({ top, behavior: "smooth" });
    });
  });

  navContainer?.addEventListener("scroll", updateScrollIndicators);
  updateScrollIndicators();

  const firstItemId = navItems[0]?.dataset.targetId;
  if (firstItemId) highlightActiveLink(firstItemId);
</script>

<style>
  /* Hide scrollbar */
  .nav-container {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  
  .nav-container::-webkit-scrollbar {
    display: none;
  }
</style> 