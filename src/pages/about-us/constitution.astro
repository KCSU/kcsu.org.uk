---
import Main from '../../layouts/Main.astro';
import DocumentHeader from '../../components/DocumentHeader.astro';
import DocumentFooter from '../../components/DocumentFooter.astro';
import PageNavigation from '../../components/PageNavigation.astro';
import constitutionData from '../../data/constitution.json';

interface Section {
  id: string;
  title: string;
  content: { text: string; list?: string[] }[];
};

const sections: Section[] = constitutionData;

// Map sections to nav items for the sidebar
const navItems = sections.map(section => ({
  id: section.id,
  title: section.title
}));
---

<Main title="Constitution">
  <div class="bg-gradient-to-b from-purple-50 to-white min-h-screen">
    <div class="container mx-auto px-4 py-16">

      <!-- Header section -->
      <DocumentHeader title="KCSU Constitution" />

      <!-- Main content -->
      <div class="flex flex-col lg:flex-row gap-8 mt-10 relative">
        <!-- Navigation sidebar -->
        <PageNavigation items={navItems} showId={true} />

        <!-- Constitution content -->
        <div class="lg:w-3/4">
          <div class="bg-white rounded-xl shadow-md p-8 lg:p-12">
            <div class="prose prose-lg max-w-none">
              {sections.map((section) => (
                <div class="mb-16 scroll-mt-24" id={section.id}>
                  <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b border-gray-200">
                    <span class="mr-2.5">{section.id}.</span>{section.title}
                  </h2>
                  <div class="space-y-4">
                    {section.content.map((item, itemIndex) => (
                      <div>
                        <div class="relative pl-6 text-gray-700 leading-relaxed">
                          <span class="absolute left-0 w-8">{itemIndex + 1}.</span>
                          {item.text}
                        </div>
                        {item.list && (
                          <ul class="pl-6 mt-2 space-y-2">
                            {item.list.map((subItem) => (
                              <li class="text-gray-700 relative pl-6 before:absolute before:left-0 before:top-[0.6rem] before:w-1.5 before:h-1.5 before:rounded-full before:bg-purple-600">
                                {subItem}
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>

            <!-- UPDATE ME!!! -->
            <DocumentFooter lastUpdated="23/03/2025" />
          </div>
        </div>
      </div>
    </div>
  </div>
</Main>

<style>
  html {
    scroll-behavior: smooth;
  }
</style> 