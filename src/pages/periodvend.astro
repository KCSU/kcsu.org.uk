background-image:
linear-gradient( 120deg, rgba(94, 22, 22, 0.658) 0px, transparent 35%, rgb(209, 158, 82) 90% );
}

p.reminder{
    opacity: 80%;
}

</style>

<script>
const params = new URLSearchParams(window.location.search);
const location = $("#location-select");

function getLocation() {
  const location_param = params.get("location") ?? 'other';
  const url = new URL(window.location.href);

    return location_param;
}

$(document).ready(function () {
  const location_param = getLocation();
  location.val(location_param).change();
});

</script>