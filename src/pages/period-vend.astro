---
import Main from "../layouts/Main.astro";
---

<Main title="Period Vending Machine Restock Request">
  <div class="request">
    <h1>Period Vend Restock Request</h1>
    <hr />
    <form action="" method="get">
      <select name="location" id="location-select">
        <option value="keynes-cub">Keynes Cubicles</option>
        <option value="keynes-uri">Keynes + Urinals</option>
        <option value="garden-hostel">Garden Hostels</option>
        <option value="library">Library</option>
        <option value="other">Other</option>
      </select>
      <button class="btn outline" type="submit" value="Send"
        >Send Request</button
      >
    </form>
    <p class="reminder">
      This page is current under construction. Please email <a
        href="mailto:genderequality@kcsu.org.uk"
        >genderequality<wbr />@kcsu.org.uk</a
      > to request restocks.
    </p>
  </div>
</Main>

<style>
  :root {
    --k-purple: #59276c;
    --k-highlight: #cfbe54;
  }

  .request {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    max-width: 30rem;
    margin: 20px auto;
    padding: 20px 20px;
    border-radius: 2px;
  }

  h1 {
    text-align: center;

    font-family: "Times New Roman", Times, serif;
    font-size: xx-large;
    max-width: 25rem;
  }

  hr {
    border: var(--k-purple) 1px solid;
    width: 30%;
    margin: 1rem;
  }

  form {
    display: flex;
    flex-direction: column;
    width: 90%;
    font-size: 1.3rem;
    gap: 1rem;
  }

  select {
    font-size: 1.2rem;
    padding: 0.3rem;
    margin: 0;
    border: 2px solid var(--k-purple);
    border-radius: 4px;
    width: 100%;
    text-align: center;
  }

  button {
    padding: 0.5rem;
    font-size: larger;
    font-weight: bold;
    background-color: var(--k-purple);
    border: var(--k-purple) 1px solid;

    color: white;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  button:hover {
    background-color: hsla(315, 58%, 33%, 1);
    background-image: linear-gradient(
      120deg,
      rgba(94, 22, 22, 0.658) 0px,
      transparent 35%,
      rgb(209, 158, 82) 90%
    );
  }

  p.reminder {
    opacity: 80%;
    text-align: center;
  }

  p.reminder a {
    color: var(--k-purple);
    text-decoration: underline var(--k-purple);
  }
</style>
<script>
  function getLocation() {
    const urlSearchParams = new URLSearchParams(window.location.search);
    const param = Object.fromEntries(urlSearchParams.entries());
    console.log("param", param);

    return param.location ?? "other";
  }

  const locationSelect = document.getElementById(
    "location-select"
  ) as HTMLSelectElement;
  locationSelect.value = getLocation();
</script>
