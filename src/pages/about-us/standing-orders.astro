---
import Main from '../../layouts/Main.astro';
import DocumentHeader from '../../components/DocumentHeader.astro';
import DocumentFooter from '../../components/DocumentFooter.astro';
import RecursiveContent from '../../components/RecursiveContent.astro';
import type { ContentItem } from '../../components/RecursiveContent.astro';
import standingOrdersData from '../../data/standing_orders.json';

interface Section {
  id: string;
  title: string;
  content: ContentItem[];
}

const sections: Section[] = standingOrdersData;
