---
interface Props {
  href: string;
  label: string;
  icon?: string;
  isEmail?: boolean;
  disabled?: boolean;
}

const { href, label, icon = "fa-external-link-alt", isEmail = false, disabled = false } = Astro.props;
---

<li>
  {href && !disabled ? (
    <a 
      href={href} 
      class="text-blue-600 hover:underline visited:text-purple-800 flex items-center"
    >
      {label}
      {isEmail ? (
        <i class="fa-regular fa-envelope ml-1 text-xs"></i>
      ) : (
        icon && <i class={`fas ${icon} ml-1 text-xs`}></i>
      )}
    </a>
  ) : (
    <span class="flex items-center opacity-50 cursor-not-allowed">{label}</span>
  )}
</li> 


