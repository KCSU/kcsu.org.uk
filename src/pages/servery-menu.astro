---
import Main from '../layouts/Main.astro';
import Badge from '../components/Badge.astro';

---

<Main title="Servery Menu">
  <div class="bg-gradient-to-b from-purple-50 to-white min-h-screen">
    <div class="container mx-auto px-4 py-16">

      <!-- Header Section -->
      <div class="text-center max-w-3xl mb-10 mx-auto pt-8">
        <h1 class="text-6xl font-bold text-gray-900 mb-8 leading-tight">
          Servery Menu
        </h1>
        <div class="h-1.5 w-32 bg-purple-600 mx-auto mb-10"></div>
        <p class="text-xl text-gray-600 italic">
          this is pretty and all but i will probably just slap a pdf viewer on it
        </p>
      </div>

      <!-- Today's Menu Section -->
      <div class="bg-white rounded-xl shadow-sm p-8 lg:p-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">13 Mar 2025 (Thursday)</h2>

        <!-- Grid for Lunch and Dinner -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Lunch Section -->
          <div class="mb-8">
            <h3 class="text-3xl font-bold text-purple-700 mb-4">Lunch</h3>
            <ul class="space-y-4">
              <li>
                <strong class="text-xl text-gray-800">Mains</strong>
                <div class="pt-2">
                  <ul class="list-disc space-y-1">
                    <li class="flex justify-between pb-2">
                        <span class="w-4/5 flex-grow-0 pr-5">
                          Roast cauliflower steak, crushed white beans & aromatic lemongrass & coriander marinade
                          <Badge label="Ve" color="green" />
                        </span>
                        <span class="w-1/5 text-gray-600 text-right">£2.85 / £4.15</span>
                    </li>
                    <li class="flex justify-between pb-2">
                        <span class="w-4/5 flex-grow-0 pr-5">Bengali Spiced salmon (F)(M) lime leaf & coconut sauce</span>
                        <span class="w-1/5 text-gray-600 text-right">£3.80 / £4.85</span>
                    </li>
                    <li class="flex justify-between pb-2">
                        <span class="w-4/5 flex-grow-0 pr-5">Chargrilled smokey BBQ pork rib steak </span>
                        <span class="w-1/5 text-gray-600 text-right">£3.60 / £4.50</span>
                    </li>
                  </ul>
                </div>
              </li>
              <li>
                <strong class="text-lg text-gray-800">Soup:</strong>
                <ul class="list-disc space-y-1">
                  <li class="flex justify-between">
                    <span>Soup of the day & roll or gluten free roll</span> <span class="text-gray-600">£1.30 / £1.80</span>
                  </li>
                </ul>
              </li>
              <li>
                <strong class="text-lg text-gray-800">Sides:</strong>
                <ul class="list-disc space-y-1">
                  <li class="flex justify-between">
                    <span>Item 1</span> <span class="text-gray-600">$3.00</span>
                  </li>
                  <li class="flex justify-between">
                    <span>Item 2</span> <span class="text-gray-600">$4.00</span>
                  </li>
                </ul>
              </li>
              <li>
                <strong class="text-lg text-gray-800">Hot Dessert:</strong>
                <ul class="list-disc space-y-1">
                  <li class="flex justify-between">
                    <span>Dessert of the day</span> <span class="text-gray-600">£1.70 / £2.10</span>
                  </li>
                </ul>
              </li>
            </ul>
          </div>

          <!-- Dinner Section -->
          <div class="md:border-l md:pl-8">
            <h3 class="text-3xl font-bold text-purple-700 mb-4">Dinner</h3>
            <ul class="space-y-4">
              <li>
                <strong class="text-lg text-gray-800">Mains:</strong>
                <ul class="list-disc space-y-1">
                  <li class="flex justify-between">
                    <span>Item 1</span> <span class="text-gray-600">$15.00</span>
                  </li>
                  <li class="flex justify-between">
                    <span>Item 2</span> <span class="text-gray-600">$18.00</span>
                  </li>
                </ul>
              </li>
              <li>
                <strong class="text-lg text-gray-800">Member's Meal Deals:</strong>
                <ul class="list-disc space-y-1">
                  <li class="flex justify-between">
                    <span>Deal 1</span> <span class="text-gray-600">$20.00</span>
                  </li>
                </ul>
              </li>
              <li>
                <strong class="text-lg text-gray-800">Sides:</strong>
                <ul class="list-disc space-y-1">
                  <li class="flex justify-between">
                    <span>Item 1</span> <span class="text-gray-600">$4.00</span>
                  </li>
                  <li class="flex justify-between">
                    <span>Item 2</span> <span class="text-gray-600">$5.00</span>
                  </li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Footer Note -->
      <div class="mt-16 pt-8 border-t border-gray-200">
        <div class="flex items-center justify-between text-sm text-gray-500">
          <p>
            This document is subject to change. For any queries, please contact
            <a href="mailto:president@kcsu.org.uk" class="text-purple-700 hover:text-purple-900">the KCSU President</a>.
          </p>
          <a 
            href="#" 
            class="inline-flex items-center text-purple-600 hover:text-purple-800"
          >
            Back to top
            <i class="fa-solid fa-arrow-up"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</Main>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>