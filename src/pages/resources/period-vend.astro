---
import DocumentHeader from "../../components/DocumentHeader.astro";
import Main from "../../layouts/Main.astro";
---

<Main title="Period Vending Machine Restock Request">
  <div class="bg-gradient-to-b from-purple-50 to-slate-50">
    <div class="container mx-auto px-4 py-16">
      <DocumentHeader title="Period Vend Restock Request" />

      <div class="flex flex-col items-center max-w-md mx-auto p-8">
        <form
          action="https://public.herotofu.com/v1/a7d26bd0-2744-11f0-ab37-9d304c3aa51c"
          method="post"
          accept-charset="UTF-8"
          class="flex flex-col w-full gap-4"
        >
          <div class="relative w-full">
            <select
              name="location"
              id="location-select"
              class="w-full text-lg p-2 px-8 border-2 border-purple-700 rounded-lg text-center appearance-none shadow-md hover:shadow-lg focus:shadow-lg transition duration-300 focus:outline-none cursor-pointer select"
            >
              <option value="keynes-cub">Keynes Cubicles</option>
              <option value="keynes-uri">Keynes + Urinals</option>
              <option value="garden-hostel">Garden Hostels</option>
              <option value="library">Library</option>
              <option value="other">Other</option>
            </select>
            <div
              class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none"
            >
              <i
                class="fa-solid fa-chevron-down text-purple-700 text-sm"
                aria-hidden="true"></i>
            </div>
          </div>

          <button
            type="submit"
            class="p-3 text-lg font-bold bg-purple-900 text-white rounded-lg shadow-md transition duration-400 cursor-pointer hover:shadow-lg/15 submit"
          >
            Send Request
          </button>

          <input
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            class="sr-only absolute"
            aria-hidden="true"
          />
        </form>
        <p class="text-center text-gray-600 mt-6">
          You can also email <a
            href="mailto:genderequality@kcsu.org.uk"
            class="text-purple-700 underline hover:text-purple-900"
            >genderequality<wbr />@kcsu.org.uk</a
          >!
        </p>
      </div>
    </div>
  </div>
</Main>

<style>
  :root {
    --k-highlight: #cfbe54;
  }

  .select:focus {
    border-color: var(--k-highlight);
  }

  .submit:hover {
    background-color: hsla(315, 58%, 33%, 1);
    background-image: linear-gradient(
      120deg,
      rgba(94, 22, 22, 0.658) 0px,
      transparent 35%,
      rgb(209, 158, 82) 90%
    );
  }
</style>

<script>
  function getLocation() {
    const urlSearchParams = new URLSearchParams(window.location.search);
    const param = Object.fromEntries(urlSearchParams.entries());

    return param.location ?? "other";
  }

  const locationSelect = document.getElementById(
    "location-select"
  ) as HTMLSelectElement;
  locationSelect.value = getLocation();
</script>
